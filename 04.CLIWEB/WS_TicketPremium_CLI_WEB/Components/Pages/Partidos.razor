@page "/partidos"
@inject ServicioFederacion ServicioFederacion
@inject NavigationManager Nav

<div class="text-center mb-3">
    <h4 style="font-weight:700;">⚽ PARTIDOS DISPONIBLES</h4>
    <p class="text-secondary" style="font-size:0.85rem;">Toca un partido para ver sus localidades</p>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}

@if (!cargando && mensaje is not null)
{
    <div class="alert alert-danger py-2" style="font-size:0.85rem;">@mensaje</div>
}

<div class="stagger-list">
@foreach (var p in partidos)
{
    <a href="/localidades?codigoPartido=@p.Codigo" class="match-card">
        <div class="match-icon" style="background:#FFF3E0;">
            <span>⚽</span>
        </div>
        <div class="match-info">
            <h4>@p.EquipoLocal vs @p.EquipoVisita</h4>
            <small>@p.Fecha.ToString("dd/MM/yyyy HH:mm") • @p.Lugar</small>
        </div>
        <span class="arrow">›</span>
    </a>
}
</div>

@if (!cargando && partidos.Count == 0)
{
    <div class="empty-state">
        <div style="font-size:3rem;">⚽</div>
        <h3>No hay partidos disponibles</h3>
    </div>
}

@code {
    List<PartidoDTO> partidos = [];
    string? mensaje;
    bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            partidos = await ServicioFederacion.ObtenerPartidosDisponibles();
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }
}
