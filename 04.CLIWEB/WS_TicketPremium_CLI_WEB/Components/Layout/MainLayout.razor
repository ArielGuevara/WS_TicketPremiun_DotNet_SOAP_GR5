@inherits LayoutComponentBase
@inject AppState AppState

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<div class="header-bar" style="padding-bottom: 3.5rem;">
    <div class="container">
        <h1>⚽ TICKET PREMIUM MONSTER</h1>
        <p>Boletos para partidos de fútbol</p>
    </div>
</div>

<div class="logo-circle mx-auto" style="margin-top: -2.5rem; position: relative; z-index: 10;">
    <img src="/images/sullivan_computer.jpg" alt="Logo" />
</div>

<div class="session-bar @(AppState.EstaLogeado ? "logged" : "")">
    @if (AppState.EstaLogeado)
    {
        <span>✓ @AppState.UsuarioActual!.Nombres (@AppState.UsuarioActual.Correo)</span>
    }
    else
    {
        <span>👤 No has iniciado sesión</span>
    }
</div>

<main class="container py-4" style="max-width: 480px;">
    @Body
</main>
