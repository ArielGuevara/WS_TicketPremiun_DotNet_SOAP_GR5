<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WS_TicketPremium_CLI_MOV_ESC.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WS_TicketPremium_CLI_MOV_ESC"
    xmlns:pages="clr-namespace:WS_TicketPremium_CLI_MOV_ESC.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource HeaderBlue}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.NavBarHasShadow="True">

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="main"
        Shell.NavBarIsVisible="False" />

</Shell>
