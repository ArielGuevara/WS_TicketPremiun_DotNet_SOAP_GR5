<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Football / Sports Blue Theme -->
    <Color x:Key="Primary">#1565C0</Color>
    <Color x:Key="PrimaryDark">#0D47A1</Color>
    <Color x:Key="PrimaryLight">#42A5F5</Color>
    <Color x:Key="PrimaryDarkText">#E3F2FD</Color>
    <Color x:Key="Secondary">#42A5F5</Color>
    <Color x:Key="SecondaryDarkText">#1565C0</Color>
    <Color x:Key="Tertiary">#FFD700</Color>
    <Color x:Key="TertiaryDark">#F9A825</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0D47A1</Color>
    <Color x:Key="OffBlack">#1a1a2e</Color>

    <Color x:Key="Gray100">#E3F2FD</Color>
    <Color x:Key="Gray200">#BBDEFB</Color>
    <Color x:Key="Gray300">#90CAF9</Color>
    <Color x:Key="Gray400">#64B5F6</Color>
    <Color x:Key="Gray500">#42A5F5</Color>
    <Color x:Key="Gray600">#1E88E5</Color>
    <Color x:Key="Gray900">#1565C0</Color>
    <Color x:Key="Gray950">#0D47A1</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <!-- Status Colors -->
    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="SuccessLight">#A5D6A7</Color>
    <Color x:Key="Error">#C62828</Color>
    <Color x:Key="ErrorLight">#EF9A9A</Color>

    <!-- Theme Colors -->
    <Color x:Key="SportsGold">#FFD700</Color>
    <Color x:Key="SportsGreen">#2E7D32</Color>
    <Color x:Key="HeaderBlue">#0D47A1</Color>
    <Color x:Key="MenuBackground">#F0F4F8</Color>
    <Color x:Key="CardBackground">White</Color>
    <Color x:Key="CardBorder">#E0E6ED</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextPrimary">#1F2937</Color>

</ResourceDictionary>
